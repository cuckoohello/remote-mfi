<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light dark">
  <title>Authorization required</title>
  <style>
    :root { color-scheme: light dark; --bg: #f5f7f8; --surface: #fff; --text: #182027; --muted: #66727b; --line: #d8dee3; --accent: #2458a6; }
    @media (prefers-color-scheme: dark) {
      :root { --bg: #14181b; --surface: #1d2327; --text: #edf1f3; --muted: #a8b2b9; --line: #39434a; --accent: #8eb8ff; }
    }
    * { box-sizing: border-box; }
    body { margin: 0; min-height: 100vh; display: grid; place-items: center; padding: 24px; background: var(--bg); color: var(--text); font: 14px/1.55 ui-sans-serif, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; }
    main { width: min(680px, 100%); background: var(--surface); border: 1px solid var(--line); border-radius: 6px; padding: clamp(22px, 5vw, 40px); }
    h1 { margin: 0 0 8px; font-size: 23px; letter-spacing: 0; }
    p { color: var(--muted); margin: 0 0 22px; }
    h2 { margin: 18px 0 8px; font-size: 14px; letter-spacing: 0; }
    pre { margin: 0; padding: 12px; border: 1px solid var(--line); border-radius: 4px; overflow-x: auto; color: var(--accent); font: 12px/1.55 ui-monospace, SFMono-Regular, Menlo, monospace; }
  </style>
</head>
<body>
  <main>
    <h1>Authorization required</h1>
    <p>This remote-mfi instance requires a Bearer token.</p>
    <h2>HTTP header</h2>
    <pre>curl -H "Authorization: Bearer &lt;token&gt;" http://host:8080/debug/usb</pre>
    <h2>Browser address</h2>
    <pre>http://host:8080/debug/usb?token=&lt;token&gt;</pre>
  </main>
</body>
</html>
